{
  "name": "dave",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "test": "node scripts/check-core-isolation.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "types": "wrangler types",
    "proto:room-ui": "cd prototypes/room-ui && pnpm install && pnpm dev",
    "e2e": "playwright test",
    "e2e:nightly": "E2E_URL=nightly playwright test"
  },
  "dependencies": {
    "@solidjs/signals": "2.0.0-rc.6",
    "@solidjs/web": "2.0.0-rc.6",
    "posthog-js": "^1.435.6",
    "solid-js": "2.0.0-rc.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.4",
    "@cloudflare/vitest-plugin": "1.3.5",
    "@playwright/test": "1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.39",
    "@types/node": "^24.13.6",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  }
}
