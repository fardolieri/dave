{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dave",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-06",
  "observability": { "enabled": true },
  "vars": {
    // TURN key ID is not secret (it only identifies the key). The API token is a Worker secret.
    "TURN_KEY_ID": "d3d456166c56302f67957272a1ff9ba5",
    // The same public PostHog project token the client uses (.env). The Room logs frames it refuses (ticket 30).
    "POSTHOG_KEY": "phc_qN9fsscYFP3YPfBdoNu4gyK2VsqGaXzALoASMUfJqm7q",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    // Which copy of the app this Worker is, sent as `build_target` with its PostHog events like the client's (vite.config.ts buildInfo).
    // `pnpm dev` runs with these top-level vars: .dev.vars sets it to "local" there (.dev.vars.example); one without it says "live".
    "BUILD_TARGET": "live"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    // Upgrade attempts per client IP. Failed handshakes never reach the Room past this.
    { "name": "UPGRADE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    // directory is filled in by @cloudflare/vite-plugin at build time.
    // Assets are served before the Worker runs, so they never count against the request budget.
    "not_found_handling": "single-page-application"
  },
  "env": {
    // Pull request previews (.github/workflows/preview.yml), built per PR and deployed under the name dave-pr-<number>,
    // which the workflow writes into the built config. Each preview is its own Worker with its own rooms, deleted when the
    // PR closes. Bindings and vars are not inherited from the top level by Wrangler, so they are repeated here; keep them
    // in step with the ones above. One rate-limit namespace for all of them, apart from the live site's (ids are per account),
    // and higher than its 10: the browser suite (e2e.yml) opens a few dozen sockets a minute from one runner IP. The Room's
    // per-socket limits still apply.
    "preview": {
      "name": "dave-preview",
      "vars": { "TURN_KEY_ID": "d3d456166c56302f67957272a1ff9ba5", "POSTHOG_KEY": "phc_qN9fsscYFP3YPfBdoNu4gyK2VsqGaXzALoASMUfJqm7q", "POSTHOG_HOST": "https://eu.i.posthog.com", "BUILD_TARGET": "preview" },
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      "ratelimits": [{ "name": "UPGRADE_LIMIT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }]
    },
    // Local only, never deployed: the build the Playwright suite runs against (CLOUDFLARE_ENV=e2e, see playwright.config.ts).
    // No upgrade limit, because every browser in a run connects from 127.0.0.1 and the suite reconnects on purpose.
    "e2e": {
      "name": "dave-e2e",
      "vars": { "TURN_KEY_ID": "d3d456166c56302f67957272a1ff9ba5", "BUILD_TARGET": "e2e" },
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      "ratelimits": []
    }
  }
}
