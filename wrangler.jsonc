{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dave",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-06",
  "observability": { "enabled": true },
  "vars": {
    // TURN key ID is not secret (it only identifies the key). The API token is a Worker secret.
    "TURN_KEY_ID": "d3d456166c56302f67957272a1ff9ba5"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    // Upgrade attempts per client IP. Failed handshakes never reach the Room past this.
    { "name": "UPGRADE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    // directory is filled in by @cloudflare/vite-plugin at build time.
    // Assets are served before the Worker runs, so they never count against the request budget.
    "not_found_handling": "single-page-application"
  },
  "env": {
    // The nightly Worker, deployed from master: a second copy of the app with its own rooms at dave-nightly.<account>.workers.dev.
    // Selected at build time with CLOUDFLARE_ENV=nightly (see .github/workflows/deploy.yml). Bindings and vars are not
    // inherited from the top level by Wrangler, so they are repeated here; keep them in step with the ones above.
    "nightly": {
      "name": "dave-nightly",
      "vars": { "TURN_KEY_ID": "d3d456166c56302f67957272a1ff9ba5" },
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      // Its own rate-limit namespace: ids are per account, so sharing 1001 would count prod and nightly attempts together.
      // Higher than prod's 10: the browser suite (`pnpm e2e:nightly`, e2e.yml after each deploy) opens a few dozen sockets a
      // minute from one runner IP. The Room's per-socket limits still apply.
      "ratelimits": [{ "name": "UPGRADE_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }]
    },
    // Local only, never deployed: the build the Playwright suite runs against (CLOUDFLARE_ENV=e2e, see playwright.config.ts).
    // No upgrade limit, because every browser in a run connects from 127.0.0.1 and the suite reconnects on purpose.
    "e2e": {
      "name": "dave-e2e",
      "vars": { "TURN_KEY_ID": "d3d456166c56302f67957272a1ff9ba5" },
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      "ratelimits": []
    }
  }
}
