{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dave",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-06",
  "observability": { "enabled": true },
  "vars": {
    // TURN key ID is not secret (it only identifies the key). The API token is a Worker secret.
    "TURN_KEY_ID": "d3d456166c56302f67957272a1ff9ba5",
    // The same public PostHog project token the client uses (.env). The Room logs frames it refuses (ticket 30).
    "POSTHOG_KEY": "phc_qN9fsscYFP3YPfBdoNu4gyK2VsqGaXzALoASMUfJqm7q",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    // Which copy of the app this Worker is, sent as `build_target` with its PostHog events like the client's (vite.config.ts buildInfo).
    // `pnpm dev` runs with these top-level vars: .dev.vars sets it to "local" there (.dev.vars.example); one without it says "live".
    "BUILD_TARGET": "live",
    // Whether this side keeps to its share of each of the Workers Free plan's daily limits (UTC): the live site 25 %, the
    // previews together 65 %, a tenth between for the minutes the figures lag (core/relayusage.ts, SIDE_SHARES, which
    // says why). From its share of any on, the Worker lets no new socket into a Room until the day ends, and tells the
    // app why (worker/index.ts, CLOSE_USED_UP). Past Cloudflare's limit every Durable Object of the account fails, both
    // sides' (2026-11-16, ticket 84; 2026-11-17, ticket 89). Not a promise: the figures are Cloudflare's, minutes behind;
    // sockets already attached stay, and a Room already awake runs on. Worker requests go on counting past it too: a
    // socket refused is one. On the paid plan, which has no daily limit: false, or it closes the rooms for nothing. The
    // previews' environment has its own.
    "FREE_PLAN_SHARES": true
  },
  "durable_objects": {
    // STORE: the one object that keeps every room's sealed texts for friends who were away (docs/adr/0009).
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Store"] }],
  "ratelimits": [
    // Upgrade attempts per client IP. Failed handshakes never reach the Room past this. 60, not 10: a browser opens a socket
    // per room and one per friend (each private conversation is a room of two, ADR 0011), all at once as it starts.
    { "name": "UPGRADE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "assets": {
    // directory is filled in by @cloudflare/vite-plugin at build time.
    // Assets are served before the Worker runs, so they never count against the request budget.
    "not_found_handling": "single-page-application"
  },
  "env": {
    // Pull request previews (.github/workflows/preview.yml), built per PR and deployed under the name dave-pr-<number>,
    // which the workflow writes into the built config. Each preview is its own Worker with its own rooms, deleted after
    // the day its PR closed on (preview-sweep.yml). Bindings and vars are not inherited from the top level by Wrangler, so they are repeated here; keep them
    // in step with the ones above. One rate-limit namespace for all of them, apart from the live site's (ids are per account),
    // and higher than its 60: the browser suite (e2e.yml) opens a few hundred sockets a minute per test it runs at once,
    // two at once from one runner IP (playwright.config.ts), a room of two's for each pair of friends in a test among
    // them (ADR 0011). 1500 leaves room: a refused upgrade is tried again, and shows as a socket that came up late
    // (ticket 61), not as a refusal. The Room's per-socket limits still apply.
    "preview": {
      "name": "dave-preview",
      "vars": { "TURN_KEY_ID": "d3d456166c56302f67957272a1ff9ba5", "POSTHOG_KEY": "phc_qN9fsscYFP3YPfBdoNu4gyK2VsqGaXzALoASMUfJqm7q", "POSTHOG_HOST": "https://eu.i.posthog.com", "BUILD_TARGET": "preview", "FREE_PLAN_SHARES": true },
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "STORE", "class_name": "Store" }] },
      "ratelimits": [{ "name": "UPGRADE_LIMIT", "namespace_id": "1003", "simple": { "limit": 1500, "period": 60 } }]
    },
    // Local only, never deployed: the build the Playwright suite runs against (CLOUDFLARE_ENV=e2e, see playwright.config.ts).
    // No upgrade limit, because every browser in a run connects from 127.0.0.1 and the suite reconnects on purpose.
    "e2e": {
      "name": "dave-e2e",
      "vars": { "TURN_KEY_ID": "d3d456166c56302f67957272a1ff9ba5", "BUILD_TARGET": "e2e" },
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "STORE", "class_name": "Store" }] },
      "ratelimits": []
    }
  }
}
